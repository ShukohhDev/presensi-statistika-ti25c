{
  "name": "presensi-mk-statistika-ti25c",
  "version": "1.0.0",
  "private": true,
  "description": "Sistem Presensi Mahasiswa Kelas TI25C - Statistika",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev": "npx -y concurrently \"npm start --prefix server\" \"npm run dev --prefix client\"",
    "server": "npm start --prefix server",
    "client": "npm run dev --prefix client",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "build": "npm run build --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "googleapis": "^140.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
